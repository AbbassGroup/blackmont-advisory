# OS
.DS_Store

# Env files — never commit secrets
**/.env
**/.env.*
!**/.env.example

# Node
**/node_modules/
# No root package — a stray root lockfile makes Turbopack pick the wrong
# project root and breaks the frontend build (next/font). Apps keep their own.
/package-lock.json
/package.json

# Next.js build
frontend/.next/
frontend/out/
frontend/build/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# Uploads (user-generated content)
backend/uploads/

# PM2
.pm2/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
